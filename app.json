{
  "expo": {
    "name": "Workbench",
    "slug": "workbench-mobile",
    "scheme": "workbench",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.workbench.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Workbench records your voice only while you hold a recording open, to turn it into text for a chat message.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "dev.workbench.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#09090b",
      "themeColor": "#09090b"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Workbench records your voice only while you hold a recording open, to turn it into text for a chat message."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090b",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#09090b"
          }
        }
      ]
    ]
  }
}
