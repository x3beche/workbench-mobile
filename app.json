{
  "expo": {
    "name": "Workbench",
    "slug": "workbench-mobile",
    "scheme": "workbench",
    "version": "1.5.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.workbench.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Workbench records your voice only while you hold a recording open, to turn it into text for a chat message.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Workbench uses the camera only when you take a photo to upload to Files.",
        "NSPhotoLibraryUsageDescription": "Workbench reads the photos you pick, to upload them to Files."
      },
      "buildNumber": "16"
    },
    "android": {
      "package": "dev.workbench.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 16,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#09090b",
      "themeColor": "#09090b"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Workbench records your voice only while you hold a recording open, to turn it into text for a chat message."
        }
      ],
      [
        "@siteed/audio-studio",
        {
          "enablePhoneStateHandling": false,
          "enableNotifications": false,
          "enableBackgroundAudio": false,
          "enableDeviceDetection": false,
          "iosBackgroundModes": {
            "useVoIP": false,
            "useAudio": false,
            "useProcessing": false,
            "useLocation": false,
            "useExternalAccessory": false
          },
          "iosConfig": {
            "allowBackgroundAudioControls": false,
            "microphoneUsageDescription": "Workbench records your voice only while you hold a recording open, to turn it into text for a chat message."
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090b",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#09090b"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Workbench reads the photos you pick, to upload them to Files.",
          "cameraPermission": "Workbench uses the camera only when you take a photo to upload to Files."
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ]
  }
}
